# Kopiera till .env.local och fyll i värdena (finns i Supabase: Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Lösenord till /admin
ADMIN_PASSWORD=byt-mig

# FPL-ligans ID (siffrorna, inte join-koden)
FPL_LEAGUE_ID=886942

# Valfritt: hemlighet för cookie-signering (annars används ADMIN_PASSWORD)
# SESSION_SECRET=nagot-langt-slumpat

# Valfritt: skyddar /api/refresh. Sätt samma värde i Vercel så skickar Cron den automatiskt.
# CRON_SECRET=nagot-langt-slumpat
